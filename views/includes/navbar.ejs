<% const user = typeof currentUser !== 'undefined' ? currentUser : null; %>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top">
  <div class="container-fluid px-3" style="flex-wrap: nowrap;">

    <a class="navbar-brand flex-shrink-0" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>

    <div class="d-flex d-md-none flex-grow-1 mx-2" style="position:relative;">
      <input class="form-control me-2 search-inp" id="mobileSearch" type="search"
             placeholder="Search" autocomplete="off"/>
      <button class="btn btn-Search flex-shrink-0" type="button">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
      <div class="suggestions-box" id="mobileSuggestions"></div>
    </div>

    <button class="navbar-toggler flex-shrink-0 d-md-none" type="button"
            data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/listings">Explore</a>
        </li>
      </ul>

      <div class="d-none d-md-flex mx-auto search-wrapper">
        <input class="form-control me-2 search-inp" id="desktopSearch" type="search"
               placeholder="Search Destinations" autocomplete="off"/>
        <button class="btn btn-Search" type="button">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
        <div class="suggestions-box" id="desktopSuggestions"></div>
      </div>

      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="/listings/new">Airbnb your home</a>
        </li>

        <% if (!user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/signup"><b>Sign up</b></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login"><b>Login</b></a>
          </li>
        <% } %>

        <% if (user) { %>
          <li class="nav-item">
            <span class="nav-link">Hello, <%= user.username %>!</span>
          </li>
          <% if (user.role === "owner") { %>
            <li class="nav-item">
              <a class="nav-link" href="/owner/bookings"><b>Bookings</b></a>
            </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link" href="/logout"><b>Logout</b></a>
          </li>
        <% } %>
      </ul>
    </div>

  </div>
</nav>