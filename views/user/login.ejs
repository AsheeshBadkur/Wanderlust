<% layout('layouts/boilerplate') -%>
<div class="row mt-3">
    <h3 class="col-6 offset-3"> Login</h3>
    <div class="col-6 offset-3">
         <form action="/login" method="POST">
        <div class="mb-3">
    <label for="username">Username</label>
    <input type="text" 
    id="username"
     class="form-control"
     name="username"
     required>

    <label for="password">Password</label>
    <input type="password" 
    id="password"
     class="form-control"
     name="password"
     required>
     
       </div>
       <button class="btn btn-success"style="background-color:#fe424d" type=submit>Login</button>

       </form>
    </div>
</div>