<% layout('layouts/boilerplate') -%>
<div class="row mt-3">
    <h3 class="col-10 col-md-6 offset-md-3">Signup For Wanderlust</h3>
    <div class="col-10 col-md-6 offset-md-3">
        <form action="/signup" method="POST">

          <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label">I am signing up as</label>
            <select name="role" class="form-select">
              <option value="user">User (I want to book places)</option>
              <option value="owner">Owner (I want to list my property)</option>
            </select>
          </div>

          <button class="btn btn-dark w-100">Sign Up</button>
        </form>
    </div>
</div>