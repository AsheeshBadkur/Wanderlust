<% layout('layouts/boilerplate') -%>

<div class="container">
  <div id="filters">
    <div class="filter">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-house"></i>
      <p>Entire Homes</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-location-dot"></i>
      <p>Nearby</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-user-group"></i>
      <p>Guests</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-mountain-city"></i>
      <p>Iconic cities</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-landmark"></i>
      <p>Historic Places</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-hotel"></i>
      <p>Hotels</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-utensils"></i>
      <p>Food & Dining</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-museum"></i>
      <p>Museums</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-person-hiking"></i>
      <p>Adventure</p>
    </div>

    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="flexswitchCheckDefault">
        <label class="form-check-label" for="flexswitchCheckDefault">Prices after Taxes</label>
      </div>
    </div>
  </div>

  <!-- Empty state message -->
  <% if (allListings.length === 0) { %>
    <div class="text-center mt-5 py-5">
      <i class="fa-solid fa-house-circle-xmark fa-3x text-muted mb-3 d-block"></i>
      <% if (currentUser && currentUser.role === "owner") { %>
        <h5 class="text-muted">You have no listings yet</h5>
        <p class="text-muted">Start by creating your first listing!</p>
        <a href="/listings/new" class="btn btn-dark mt-2">
          <i class="fa-solid fa-plus me-1"></i> Create Listing
        </a>
      <% } else { %>
        <h5 class="text-muted">No listings found</h5>
        <p class="text-muted">Check back later for new listings</p>
      <% } %>
    </div>
  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-4">
      <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing image" style="height: 20rem;"/>
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b> <br/>
               Price/night &#x20B9;
<span class="base-price"><%= listing.price.toLocaleString("en-IN") %></span>
<span class="taxed-price"><%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %></span>
<i class="tax-info">incl. 18% GST</i>
              </p>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  <% } %>

</div>

<script>
const taxSwitch = document.getElementById('flexswitchCheckDefault');

if (taxSwitch) {
  const updatePrices = () => {
    document.querySelectorAll('.listing-card').forEach((card) => {
      const basePrice = card.querySelector('.base-price');
      const taxedPrice = card.querySelector('.taxed-price');
      const taxInfo = card.querySelector('.tax-info');

      if (!basePrice || !taxedPrice || !taxInfo) return;

      basePrice.style.display = taxSwitch.checked ? 'none' : 'inline';
      taxedPrice.style.display = taxSwitch.checked ? 'inline' : 'none';
      taxInfo.style.display = taxSwitch.checked ? 'inline' : 'none';
    });
  };

  taxSwitch.addEventListener('change', updatePrices);
  updatePrices();
}

  // Active filter highlight
  const filters = document.querySelectorAll('.filter');
  filters.forEach(filter => {
    filter.addEventListener('click', () => {
      filters.forEach(f => f.classList.remove('active'));
      filter.classList.add('active');
    });
  });
</script>