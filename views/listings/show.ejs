<% layout('layouts/boilerplate') -%>
<script>
    const mapToken="<%= process.env.MAP_TOKEN %>"
    const listing=<%- JSON.stringify(listing) %>
</script>

<div class="container mt-3">
  <div class="row">
    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">

      <!-- Title -->
      <h4 class="mb-3"><b><%= listing.title %></b></h4>

      <!-- Listing Card -->
      <div class="card show-card listing-card mb-3">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing Image">
        <div class="card-body p-3">
          <p class="card-text mb-1">Owned by <i><%= listing.owner.username %></i></p><br>
          <p class="card-text mb-1"><%= listing.description %></p>
          <p class="card-text mb-1">
            <i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %>
          </p>
          <p class="card-text mb-3">
            <b>&#x20B9; <%= listing.price.toLocaleString("en-IN") %></b> / night
          </p><br>

          <!-- Book Now / Booked / Login -->
          <% if (currentUser && currentUser.role !== "owner") { %>
            <% if (hasBooked) { %>
              <button class="btn btn-success" disabled>✔ Already Booked</button>
            <% } else { %>
              <a href="/listings/<%= listing._id %>/bookings/new" class="btn btn-dark">Book Now</a>
            <% } %>
          <% } %>
          <% if (!currentUser) { %>
            <a href="/login" class="btn btn-outline-dark">Login to Book</a>
          <% } %>
        </div>
      </div>

      <!-- Edit / Delete — owner only -->
      <% if (currentUser && currentUser._id.equals(listing.owner._id)) { %>
        <div class="d-flex gap-2 mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button class="btn btn-dark">Delete</button>
          </form>
        </div>
      <% } %>

      <hr>

      <!-- Leave a Review -->
      <h4 class="mb-3">Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mb-4">
       <div class="mb-3">
  <label class="form-label">Rating</label>
  <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing"></label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good"></label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average"></label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good"></label>
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible"></label>
</fieldset>
</div>
        <div class="mb-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
          <div class="invalid-feedback">Please enter a review to submit</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>

      <hr>

      <!-- All Reviews -->
<% if(listing.reviews.length > 0) { %>
  <h4 class="mb-3">All Reviews</h4>
  <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
    <% for(review of listing.reviews) { %>
      <div class="col">
        <div class="card h-100 p-3" style="border-radius: 1rem; border: 1px solid #ebebeb;">
          <div class="d-flex align-items-center mb-2">
            <h6 class="mb-0"><%= review.author.username %></h6>
          </div>
          <p class="starability-result mb-1" data-rating="<%= review.rating %>"></p>
          <p class="card-text text-muted mb-2"><%= review.comment %></p>
          <% if (currentUser && currentUser._id.equals(review.author._id)) { %>
            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
              <button class="btn btn-sm btn-dark">Delete</button>
            </form>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
     <!-- Map -->
<hr>
<h4 class="mb-3">Where You'll be</h4>
<div id="map" class="mb-5"></div>
<div id="map-placeholder" class="mb-5 p-4 text-center bg-light rounded" style="display:none;">
  <i class="fa-solid fa-map-location-dot fa-2x text-muted mb-2 d-block mb-2"></i>
  <p class="text-muted mb-0">
    Map not available for this listing.
    <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>
      Please <a href="/listings/<%= listing._id %>/edit">edit and update</a> this listing to enable the map.
    <% } %>
  </p>
</div>
    </div>
  </div>
</div>

<script src="/js/map.js"></script>